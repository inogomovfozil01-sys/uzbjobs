# ==============================================================================
# UzbJobs Environment Configuration
# ==============================================================================

# PostgreSQL Database (Railway / Neon / Supabase / Local PostgreSQL)
# Example: postgresql://postgres:password@localhost:5432/uzbjobs?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/uzbjobs?schema=public"

# Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Google Programmable Search API (Custom Search JSON API)
# Get key from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_SEARCH_API_KEY=""
# Search Engine ID from https://programmablesearchengine.google.com/
GOOGLE_SEARCH_ENGINE_ID="0462cf8522da840f7"
NEXT_PUBLIC_GOOGLE_SEARCH_CX="0462cf8522da840f7"

# NextAuth / Auth.js
# Generate a secret: openssl rand -base64 32
AUTH_SECRET="uzbjobs-super-secret-production-auth-key-change-in-prod"
NEXTAUTH_SECRET="uzbjobs-super-secret-production-auth-key-change-in-prod"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Optional: for Google Sign-In)
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP Email Configuration (Optional: for sending notifications & alerts)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="UzbJobs <noreply@uzbjobs.uz>"

# Cron / Background Scanner Secret
# Protects the scheduled trigger endpoint /api/cron/scan
CRON_SECRET="uzbjobs-cron-secret-change-in-production"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
